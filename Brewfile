# brew bundle
#
# homebrew/core, homebrew/cask and homebrew/bundle are all built in now;
# tapping them explicitly is unnecessary and slow. homebrew/cask-versions was
# removed upstream and made this file fail outright.

# deployment
brew "stow"                 # install.sh symlinks every package with this

# shell and editor
brew "git"
brew "vim"
brew "tmux"

# search and navigation
brew "ripgrep"              # .vimrc grepprg, ackprg, and the theme picker
brew "fd"
brew "fzf"                  # `theme` picker needs the focus binding, 0.30+

# git
brew "gh"
brew "git-delta"            # core.pager in .gitconfig
brew "lazygit"

# languages and tools
brew "pyenv"
brew "rbenv"
brew "node"
brew "jq"
brew "curl"
brew "ctags"
brew "gnupg"
brew "htop"
brew "plantuml"             # .vimrc plantuml-previewer

cask "iterm2"
cask "docker"
cask "firefox"
cask "thunderbird"
cask "vlc"
cask "numi"
cask "appcleaner"           # a cask, not a formula -- was listed as brew
