#!/usr/bin/env bash
#
# theme -- switch iTerm2, vim and tmux colours together.
#
# A theme is a directory under ~/.config/theme/themes/<slug>/, and
# ~/.config/theme/current is a symlink to the active one. Configs reference the
# stable "current" path, so switching is just repointing a symlink and poking
# each layer to reload.
#
# Themes are fetched from mbadolato/iTerm2-Color-Schemes, which publishes both
# an .itermcolors palette and a standalone vim colorscheme for ~600 themes. It
# has no tmux output, so the tmux theme is generated here from the palette.
#
#   theme                 pick from installed themes, applying live as you move
#   theme browse          pick from every upstream theme, install on select
#   theme set <name>      apply an installed theme
#   theme next | prev     cycle installed themes
#   theme list            list installed themes
#   theme current         print the active theme
#   theme install <Name>  fetch and install by upstream name
#   theme remove <name>   delete an installed theme
#   theme reapply         re-apply current theme (used by shell startup)
#
set -euo pipefail

REPO_RAW="https://raw.githubusercontent.com/mbadolato/iTerm2-Color-Schemes/master"
THEME_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
THEMES_DIR="$THEME_HOME/themes"
CURRENT="$THEME_HOME/current"
CACHE_DIR="$THEME_HOME/cache"
CATALOGUE="$CACHE_DIR/schemes.txt"
VIM_COLORS="$HOME/.vim/colors"

die() { printf 'theme: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

slugify() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
        | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//'
}

urlencode() {
    python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$1"
}

# ---------------------------------------------------------------- generation

# Parse the .itermcolors plist into a shell-sourceable palette.
gen_palette() {
    local dir="$1" name="$2"
    python3 - "$dir" "$name" <<'PY'
import plistlib, sys, os
dir_, name = sys.argv[1], sys.argv[2]
with open(os.path.join(dir_, 'scheme.itermcolors'), 'rb') as f:
    d = plistlib.load(f)

def hexof(key, default=None):
    c = d.get(key)
    if c is None:
        return default
    return '%02x%02x%02x' % tuple(
        max(0, min(255, round(c.get('%s Component' % ch, 0.0) * 255)))
        for ch in ('Red', 'Green', 'Blue'))

bg = hexof('Background Color', '000000')
fg = hexof('Foreground Color', 'ffffff')
ansi = [hexof('Ansi %d Color' % i, '000000') for i in range(16)]

# Relative luminance of the background decides light vs dark, which drives the
# lightline fallback and a few tmux contrast choices.
r, g, b = (int(bg[i:i+2], 16) / 255 for i in (0, 2, 4))
lum = 0.2126 * r + 0.7152 * g + 0.0722 * b

out = [
    "NAME='%s'" % name.replace("'", "'\\''"),
    "BG='%s'" % bg,
    "FG='%s'" % fg,
    "CURSOR='%s'" % hexof('Cursor Color', fg),
    "CURSOR_FG='%s'" % hexof('Cursor Text Color', bg),
    "SELBG='%s'" % hexof('Selection Color', ansi[8]),
    "SELFG='%s'" % hexof('Selected Text Color', fg),
    "IS_DARK=%d" % (1 if lum < 0.5 else 0),
]
out += ["ANSI%d='%s'" % (i, c) for i, c in enumerate(ansi)]
with open(os.path.join(dir_, 'palette.sh'), 'w') as f:
    f.write('\n'.join(out) + '\n')
PY
}

# iTerm2 is recoloured with OSC 1337 SetColors. Inside tmux the sequence has to
# be wrapped in DCS passthrough (and its own ESC doubled), which is why
# .tmux.conf needs `allow-passthrough on`.
gen_iterm() {
    cat > "$1/iterm.sh" <<'SH'
#!/usr/bin/env bash
# Generated by `theme`. Applies this palette to iTerm2 in the current session.
. "$(dirname "${BASH_SOURCE[0]}")/palette.sh"

payload="1337;SetColors=fg=$FG,bg=$BG,curfg=$CURSOR_FG,curbg=$CURSOR"
payload="$payload,selbg=$SELBG,selfg=$SELFG"
names=(black red green yellow blue magenta cyan white
       br_black br_red br_green br_yellow br_blue br_magenta br_cyan br_white)
for i in "${!names[@]}"; do
    eval "c=\$ANSI$i"
    payload="$payload,${names[$i]}=$c"
done

# Write to the controlling terminal, not stdout: the fzf picker invokes this
# through execute-silent, which sends stdout to /dev/null. With no controlling
# terminal there is nothing to recolour, and writing to stdout would corrupt
# the output of callers like `theme next`.
if { : >/dev/tty; } 2>/dev/null; then exec >/dev/tty; else exit 0; fi

case "$TERM" in
    screen*|tmux*) printf '\033Ptmux;\033\033]%s\a\033\\' "$payload" ;;
    *)             printf '\033]%s\a' "$payload" ;;
esac
SH
    chmod +x "$1/iterm.sh"
}

gen_tmux() {
    local dir="$1"
    # shellcheck disable=SC1091
    . "$dir/palette.sh"
    cat > "$dir/tmux.conf" <<EOF
# Generated by \`theme\` from $NAME.
set -g status-style "bg=#$BG,fg=#$FG"
set -g status-left  "#[bg=#$ANSI4,fg=#$BG,bold] #S #[default] "
set -g status-right "#[fg=#$ANSI8]#{?client_prefix,#[fg=#$ANSI1]PREFIX ,}%H:%M "
set -g status-left-length 32

setw -g window-status-current-style "fg=#$ANSI6,bold"
setw -g window-status-style         "fg=#$ANSI8"
setw -g window-status-activity-style "fg=#$ANSI3"

set -g pane-border-style        "fg=#$ANSI0"
set -g pane-active-border-style "fg=#$ANSI4"
set -g message-style            "bg=#$ANSI3,fg=#$BG"
set -g mode-style               "bg=#$SELBG,fg=#$SELFG"
EOF
}

# lightline ships no upstream themes, so match on name and otherwise fall back
# by background luminance.
lightline_theme() {
    local dir="$1" ll_dir="$HOME/.vim/plugged/lightline.vim/autoload/lightline/colorscheme"
    # shellcheck disable=SC1091
    . "$dir/palette.sh"
    local slug
    slug=$(slugify "$NAME")
    if [ -d "$ll_dir" ]; then
        local f
        for f in "$ll_dir"/*.vim; do
            [ -e "$f" ] || continue
            if [ "$(slugify "$(basename "$f" .vim)")" = "$slug" ]; then
                basename "$f" .vim; return
            fi
        done
    fi
    [ "${IS_DARK:-1}" -eq 1 ] && echo one || echo PaperColor_light
}

gen_vim() {
    local dir="$1"
    # shellcheck disable=SC1091
    . "$dir/palette.sh"
    local colors_name ll
    colors_name=$(sed -n 's/^let g:colors_name *= *["'"'"']\(.*\)["'"'"'].*/\1/p' "$dir/vim.vim" | head -1)
    [ -n "$colors_name" ] || colors_name="$NAME"
    ll=$(lightline_theme "$dir")
    cat > "$dir/theme.vim" <<EOF
" Generated by \`theme\` from $NAME. Sourced by .vimrc and on FocusGained.
if !exists('g:colors_name') || g:colors_name !=# '$colors_name'
  silent! colorscheme $colors_name
endif

let g:lightline = get(g:, 'lightline', {})
if get(g:lightline, 'colorscheme', '') !=# '$ll'
  " Source the palette explicitly. Relying on autoload of the
  " g:lightline#colorscheme#<name>#palette variable fails in this config --
  " lightline reports 'Could not load colorscheme' and silently falls back to
  " its default palette.
  silent! runtime autoload/lightline/colorscheme/$ll.vim
  let g:lightline.colorscheme = '$ll'
  if exists('*lightline#init')
    call lightline#init()
    call lightline#colorscheme()
    call lightline#update()
  endif
endif
EOF
    mkdir -p "$VIM_COLORS"
    ln -sfn "$dir/vim.vim" "$VIM_COLORS/$colors_name.vim"
}

# ------------------------------------------------------------------ commands

cmd_install() {
    local name="${1:-}"; [ -n "$name" ] || die "install: need a theme name"
    local slug dir enc vim_enc
    slug=$(slugify "$name"); dir="$THEMES_DIR/$slug"
    enc=$(urlencode "$name")
    # schemes/ uses spaces ("Gruvbox Dark.itermcolors") but vim/ uses dashes
    # ("Gruvbox-Dark.vim"). That substitution maps all 606 names 1:1.
    vim_enc=$(urlencode "${name// /-}")
    mkdir -p "$dir"
    curl -fsSL "$REPO_RAW/schemes/$enc.itermcolors" -o "$dir/scheme.itermcolors" \
        || { rm -rf "$dir"; die "no upstream scheme named '$name'"; }
    curl -fsSL "$REPO_RAW/vim/$vim_enc.vim" -o "$dir/vim.vim" \
        || { rm -rf "$dir"; die "no upstream vim colorscheme for '$name'"; }
    gen_palette "$dir" "$name"
    gen_iterm "$dir"
    gen_tmux "$dir"
    gen_vim "$dir"
    printf '%s\n' "$slug"
}

catalogue() {
    if [ ! -s "$CATALOGUE" ] || [ -n "${1:-}" ]; then
        mkdir -p "$CACHE_DIR"
        if have gh; then
            gh api --paginate repos/mbadolato/iTerm2-Color-Schemes/contents/schemes \
                --jq '.[].name' 2>/dev/null | sed 's/\.itermcolors$//' > "$CATALOGUE"
        else
            curl -fsSL "https://api.github.com/repos/mbadolato/iTerm2-Color-Schemes/contents/schemes?per_page=1000" \
                | python3 -c 'import json,sys; [print(e["name"][:-12]) for e in json.load(sys.stdin)]' > "$CATALOGUE"
        fi
        [ -s "$CATALOGUE" ] || die "could not fetch the theme catalogue"
    fi
    cat "$CATALOGUE"
}

apply() {
    local slug="$1" dir="$THEMES_DIR/$1"
    [ -d "$dir" ] || die "no such theme: $slug (try: theme install)"
    mkdir -p "$THEME_HOME"
    ln -sfn "$dir" "$CURRENT"

    [ -x "$dir/iterm.sh" ] && "$dir/iterm.sh" || true

    if [ -n "${TMUX:-}" ] && have tmux; then
        tmux source-file "$dir/tmux.conf" 2>/dev/null || true
        tmux refresh-client -S 2>/dev/null || true
    fi
    # Running vim re-sources current/theme.vim on FocusGained; nothing to push.
}

cmd_list() {
    [ -d "$THEMES_DIR" ] || return 0
    local d
    for d in "$THEMES_DIR"/*/; do
        [ -d "$d" ] || continue
        basename "$d"
    done | sort
}

cmd_current() {
    [ -L "$CURRENT" ] && basename "$(readlink "$CURRENT")" || echo "none"
}

cmd_swatch() {
    local dir="$THEMES_DIR/${1:?}"
    [ -f "$dir/palette.sh" ] || { echo "not installed"; return 0; }
    # shellcheck disable=SC1091
    . "$dir/palette.sh"
    local r g b
    hexbg() { r=$((16#${1:0:2})); g=$((16#${1:2:2})); b=$((16#${1:4:2}))
              printf '\033[48;2;%d;%d;%dm' "$r" "$g" "$b"; }
    hexfg() { r=$((16#${1:0:2})); g=$((16#${1:2:2})); b=$((16#${1:4:2}))
              printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"; }

    printf '%s  ' "$NAME"
    [ "$IS_DARK" -eq 1 ] && printf 'dark\n\n' || printf 'light\n\n'
    local i
    for i in 0 1 2 3 4 5 6 7; do eval "hexbg \$ANSI$i"; printf '   '; done
    printf '\033[0m\n'
    for i in 8 9 10 11 12 13 14 15; do eval "hexbg \$ANSI$i"; printf '   '; done
    printf '\033[0m\n\n'
    hexbg "$BG"; hexfg "$FG";  printf '  the quick brown fox      \033[0m\n'
    hexbg "$BG"; hexfg "$ANSI4"; printf '  def '; hexfg "$ANSI3"; printf 'jumps'
    hexfg "$FG"; printf '(over, lazy):        \033[0m\n'
    # %s, not a bare format string: "- removed" would be parsed as an option.
    hexbg "$BG"; hexfg "$ANSI2"; printf '%s' '  + added  '
    hexfg "$ANSI1"; printf '%s\033[0m\n' '- removed      '
    hexbg "$BG"; hexfg "$ANSI8"; printf '  # comment               \033[0m\n'
}

cmd_pick() {
    have fzf || die "fzf is required for the picker"
    local themes original
    themes=$(cmd_list)
    [ -n "$themes" ] || die "no themes installed yet -- try: theme browse"
    original=$(cmd_current)

    local chosen
    # focus: applies as you move, so cycling is a live preview.
    chosen=$(printf '%s\n' "$themes" | fzf \
        --ansi --height=60% --reverse --prompt='theme> ' \
        --preview="$0 swatch {}" --preview-window=right,50%,border-left \
        --bind="focus:execute-silent($0 set {})" \
        || true)

    if [ -n "$chosen" ]; then
        apply "$chosen"
    elif [ "$original" != "none" ]; then
        apply "$original"   # Esc restores what you started with
    fi
}

cmd_browse() {
    have fzf || die "fzf is required for the picker"
    local chosen
    chosen=$(catalogue | fzf \
        --ansi --height=60% --reverse --prompt='install> ' \
        --preview="$0 preview-remote {}" --preview-window=right,50%,border-left \
        || true)
    [ -n "$chosen" ] || return 0
    local slug
    slug=$(cmd_install "$chosen")
    apply "$slug"
    printf 'installed and applied: %s\n' "$slug"
}

# Preview an upstream theme without installing it: fetch the palette into the
# cache and render the same swatch.
cmd_preview_remote() {
    local name="${1:?}" slug dir
    slug=$(slugify "$name"); dir="$CACHE_DIR/preview/$slug"
    if [ ! -f "$dir/palette.sh" ]; then
        mkdir -p "$dir"
        curl -fsSL "$REPO_RAW/schemes/$(urlencode "$name").itermcolors" \
            -o "$dir/scheme.itermcolors" 2>/dev/null || { echo "fetch failed"; return 0; }
        gen_palette "$dir" "$name"
    fi
    THEMES_DIR="$CACHE_DIR/preview" cmd_swatch "$slug"
}

cmd_cycle() {
    local dir="${1:-next}" themes cur next
    themes=$(cmd_list); [ -n "$themes" ] || die "no themes installed"
    cur=$(cmd_current)
    [ "$dir" = prev ] && themes=$(printf '%s\n' "$themes" | tail -r 2>/dev/null || printf '%s\n' "$themes" | tac)
    next=$(printf '%s\n' "$themes" | awk -v c="$cur" 'BEGIN{f=0} {a[NR]=$0; if($0==c) f=NR} END{print (f==0||f==NR)?a[1]:a[f+1]}')
    apply "$next"
    printf '%s\n' "$next"
}

usage() { sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-pick}" in
    pick|"")         cmd_pick ;;
    browse)          cmd_browse ;;
    set)             apply "$(slugify "${2:?theme set: need a name}")" ;;
    next)            cmd_cycle next ;;
    prev)            cmd_cycle prev ;;
    list)            cmd_list ;;
    current)         cmd_current ;;
    install)         slug=$(cmd_install "${2:?theme install: need a name}"); apply "$slug"; echo "$slug" ;;
    remove)          rm -rf "${THEMES_DIR:?}/$(slugify "${2:?theme remove: need a name}")" ;;
    reapply)         [ -L "$CURRENT" ] && [ -x "$CURRENT/iterm.sh" ] && "$CURRENT/iterm.sh" || true ;;
    swatch)          cmd_swatch "${2:?}" ;;
    preview-remote)  cmd_preview_remote "${2:?}" ;;
    refresh)         catalogue force >/dev/null; wc -l < "$CATALOGUE" ;;
    -h|--help|help)  usage ;;
    *)               die "unknown command: $1 (try: theme --help)" ;;
esac
