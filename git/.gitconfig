[user]
    name = Colin Campbell
    email = colin@emergesource.com
[core]
    editor = vim
    excludesfile = ~/.gitignore_global   
	pager = delta
[color]
    ui = true
[alias]
    co = checkout
    st = status
    s = status --short --branch
    ci = commit
    br = branch
    pr = pull --rebase
    ll = log --oneline --abbrev-commit --all --graph --decorate
    l = log --oneline --decorate
    up = "!git remote update -p; git merge --ff-only @{u}"
    # squash-merge a branch, GitHub style: one commit, subject = branch
    # name, body = the squashed commit subjects. Opens the editor so the
    # subject can be fixed up. There is no merge.squash config -- git
    # ignores it -- so this is the closest thing to a default.
    sq = "!f() { git merge --squash \"$1\" && git commit --edit -m \"$1\" -m \"$(git log --reverse --format='* %s' HEAD..\"$1\")\"; }; f"

[pull]
    rebase = true
[delta]
	navigate = true
	dark = true
	side-by-side = false

[rerere]
    # Record how a conflict was resolved and replay it automatically the next
    # time the same one appears -- which is what rebasing and repeated merges
    # of a long-lived branch produce. Fewer markers ever reach the editor.
    enabled = true
    autoUpdate = true
